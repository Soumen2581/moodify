{
  "name": "moodify",
  "version": "1.0.0",
  "description": "Mood-based YouTube music suggestions — full MERN stack (MongoDB, Express, React, Node).",
  "main": "src/server.js",
  "scripts": {
    "start": "docker compose up --build -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f app",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "keywords": [
    "mern",
    "react",
    "vite",
    "express",
    "mongodb",
    "youtube-api",
    "mood",
    "docker"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  }
}
